# Copy file này thành .env.local rồi điền 2 giá trị lấy ở Supabase > Project Settings > API.
# anon key là key CÔNG KHAI (được phép nằm trong frontend). TUYỆT ĐỐI không dán service_role key vào đây.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Tên đăng nhập không có "@" sẽ được ghép với domain này, vd "thien" -> thien@aptiskytich.vn
VITE_LOGIN_DOMAIN=aptiskytich.vn
